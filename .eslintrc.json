{
  "extends": [
    "next/core-web-vitals",
    "standard",
    "plugin:tailwindcss/recommended",
    "prettier"
  ],
  "rules": {
    "camelcase": [
      "error",
      {
        "properties": "never",
        "ignoreDestructuring": true,
        "allow": ["svix_id"]
      }
    ],
    "spaced-comment": "off",
    "no-unneeded-ternary": "off"
  }
}
